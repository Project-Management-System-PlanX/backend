# ==============================================================================
# TeamUp Backend - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - it contains sensitive credentials
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3002

# JWT Secret (change this to a strong random string)
JWT_SECRET=your-super-secret-key-change-this-to-random-string

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Aiven PostgreSQL Databases
# ------------------------------------------------------------------------------
# Get these from: https://console.aiven.io
# Format: postgres://avnadmin:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Workspace Service Database
DATABASE_URL=postgresql://avnadmin:PASSWORD@HOST:PORT/teamup-workspace?sslmode=require

# Future Services (uncomment when implementing)
# MESSAGE_DATABASE_URL=postgresql://avnadmin:PASSWORD@HOST:PORT/teamup-message?sslmode=require
# TASK_DATABASE_URL=postgresql://avnadmin:PASSWORD@HOST:PORT/teamup-task?sslmode=require
# MEETING_DATABASE_URL=postgresql://avnadmin:PASSWORD@HOST:PORT/teamup-meeting?sslmode=require
# FILE_DATABASE_URL=postgresql://avnadmin:PASSWORD@HOST:PORT/teamup-file?sslmode=require
# NOTIF_DATABASE_URL=postgresql://avnadmin:PASSWORD@HOST:PORT/teamup-notif?sslmode=require

# ------------------------------------------------------------------------------
# Upstash Redis
# ------------------------------------------------------------------------------
# Get from: https://console.upstash.com
# Format: redis://default:PASSWORD@HOST:PORT
REDIS_URL=redis://default:PASSWORD@HOST:PORT

# ------------------------------------------------------------------------------
# LiveKit (Video/Audio - Phase 3)
# ------------------------------------------------------------------------------
# Get from: https://cloud.livekit.io
# LIVEKIT_API_KEY=your-api-key
# LIVEKIT_API_SECRET=your-api-secret
# LIVEKIT_URL=wss://your-project.livekit.cloud

# ------------------------------------------------------------------------------
# File Storage (Phase 2)
# ------------------------------------------------------------------------------
# AWS S3 / Cloudflare R2 / etc.
# STORAGE_PROVIDER=s3
# STORAGE_BUCKET=teamup-files
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY=your-access-key
# STORAGE_SECRET_KEY=your-secret-key

# ------------------------------------------------------------------------------
# Email Service (Future)
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=TeamUp <noreply@teamup.com>

# ------------------------------------------------------------------------------
# Authentication (Future)
# ------------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# ------------------------------------------------------------------------------
# Monitoring & Logging (Future)
# ------------------------------------------------------------------------------
# SENTRY_DSN=https://your-sentry-dsn
# LOG_LEVEL=info
