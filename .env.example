# Aiven PostgreSQL URLs
WORKSPACE_DATABASE_URL=postgresql://user:password@host:port/teamup-workspace-db?sslmode=require
MESSAGE_DATABASE_URL=postgresql://user:password@host:port/teamup-message-db?sslmode=require
TASK_DATABASE_URL=postgresql://user:password@host:port/teamup-task-db?sslmode=require
MEETING_DATABASE_URL=postgresql://user:password@host:port/teamup-meeting-db?sslmode=require
FILE_DATABASE_URL=postgresql://user:password@host:port/teamup-file-db?sslmode=require
NOTIF_DATABASE_URL=postgresql://user:password@host:port/teamup-notif-db?sslmode=require

# Redis (Upstash)
REDIS_URL=redis://default:password@host:port

# Livekit (Phase 3)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# App Config
NODE_ENV=development
JWT_SECRET=your-secret-key-here
PORT=3002
