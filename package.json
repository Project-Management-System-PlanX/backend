{
  "name": "teamup-backend",
  "version": "1.0.0",
  "description": "TeamUp Microservices Backend",
  "private": true,
  "workspaces": [
    "services/*",
    "shared/*"
  ],
  "scripts": {
    "install:all": "npm install && npm install --workspaces",
    "dev:workspace": "npm run start:dev --workspace=services/workspace-service",
    "dev:websocket": "npm run start:dev --workspace=services/websocket-hub",
    "dev:all": "concurrently \"npm run dev:workspace\" \"npm run dev:websocket\"",
    "start:workspace": "cd services/workspace-service && node dist/main.js",
    "start:websocket": "npm run start:prod --workspace=services/websocket-hub",
    "build:workspace": "cd services/workspace-service && npx prisma generate && npx nest build",
    "build:all": "npm run build:workspace",
    "db:migrate": "npm run prisma:migrate --workspace=services/workspace-service",
    "db:deploy": "cd services/workspace-service && npx prisma migrate deploy",
    "db:generate": "npm run prisma:generate --workspace=services/workspace-service",
    "db:studio": "npm run prisma:studio --workspace=services/workspace-service",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "prepare": "node -e \"if(process.env.NODE_ENV !== 'production'){process.exit(1)}\" || husky",
    "clean": "rm -rf node_modules services/*/node_modules services/*/dist shared/*/node_modules"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.15",
    "@types/node": "^20.11.5",
    "concurrently": "^8.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.98.0"
  }
}