generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User profile — synced from Clerk on first login and kept up-to-date
model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique // Clerk's user_xxx ID (the JWT sub claim)
  email     String   @unique
  firstName String?
  lastName  String?
  username  String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Every employee on the main dashboard belongs to a Company
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  
  // The projects they are assigned to
  projects  ProjectMember[]

  @@map("users")
}

// Company (Tenant)
model Company {
  id          String   @id @default(uuid())
  name        String
  isActive    Boolean  @default(true)
  subscriptionPlan String @default("FREE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  users       User[]
  projects    Project[]
  
  @@map("companies")
}

// Project (Replaces Workspace)
model Project {
  id          String   @id @default(uuid())
  companyId   String   // Belongs strictly to a company
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members     ProjectMember[]
  channels    Channel[] 
  
  @@map("projects")
}

enum ProjectRole {
  MANAGER
  TECH_LEAD
  HR
  EMPLOYEE
}

// Project Assignments
model ProjectMember {
  id          String      @id @default(uuid())
  projectId   String
  userId      String
  role        ProjectRole @default(EMPLOYEE)
  joinedAt    DateTime    @default(now())
  
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

// Channel
model Channel {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  type        String   @default("PUBLIC")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members   ChannelMember[]
  groups    Group[]

  @@map("channels")
}

model ChannelMember {
  id        String   @id @default(uuid())
  channelId String
  userId    String
  role      String   @default("MEMBER")
  joinedAt  DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@map("channel_members")
}

// Group
model Group {
  id          String   @id @default(uuid())
  channelId   String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  channel Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  members GroupMember[]

  @@map("groups")
}

model GroupMember {
  id       String   @id @default(uuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_members")
}
